<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:padding="20dp">
        <LinearLayout android:layout_width="420dp" android:layout_height="wrap_content"
            android:orientation="vertical" android:background="@drawable/bg_card" android:padding="22dp">

            <ImageView android:layout_width="150dp" android:layout_height="87dp" android:layout_gravity="center_horizontal"
                android:src="@drawable/xlax_logo" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:background="@drawable/bg_tabs" android:padding="4dp">
                <TextView android:id="@+id/tabLogin" android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:gravity="center" android:text="Giriş yap"
                    android:textStyle="bold" android:textSize="15sp" android:background="@drawable/sel_tab" />
                <TextView android:id="@+id/tabRegister" android:layout_width="0dp" android:layout_height="40dp"
                    android:layout_weight="1" android:gravity="center" android:text="Hesap oluştur"
                    android:textStyle="bold" android:textSize="15sp" android:background="@drawable/sel_tab" />
            </LinearLayout>

            <TextView style="@style/Label" android:text="Kullanıcı adı (oyundaki adın)" />
            <EditText android:id="@+id/etUser" style="@style/Field" android:inputType="textVisiblePassword|textNoSuggestions" />

            <TextView style="@style/Label" android:text="Şifre" />
            <EditText android:id="@+id/etPass" style="@style/Field" android:inputType="textPassword" />

            <LinearLayout android:id="@+id/regGroup" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <TextView style="@style/Label" android:text="Şifre tekrar" />
                <EditText android:id="@+id/etPass2" style="@style/Field" android:inputType="textPassword" />
                <TextView style="@style/Label" android:text="Cinsiyet" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <TextView android:id="@+id/gMale" android:layout_width="0dp" android:layout_height="48dp"
                        android:layout_weight="1" android:gravity="center" android:text="Erkek"
                        android:background="@drawable/sel_chip" android:textSize="14sp" />
                    <TextView android:id="@+id/gFemale" android:layout_width="0dp" android:layout_height="48dp"
                        android:layout_weight="1" android:layout_marginHorizontal="8dp" android:gravity="center"
                        android:text="Kadın" android:background="@drawable/sel_chip" android:textSize="14sp" />
                    <TextView android:id="@+id/gNone" android:layout_width="0dp" android:layout_height="48dp"
                        android:layout_weight="1" android:gravity="center" android:text="Belirtmek istemiyorum"
                        android:background="@drawable/sel_chip" android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView android:id="@+id/tvError" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:textColor="#F87171" android:textSize="13sp" android:visibility="gone" />

            <TextView android:id="@+id/btnSubmit" android:layout_width="match_parent" android:layout_height="54dp"
                android:layout_marginTop="16dp" android:gravity="center" android:background="@drawable/bg_gold"
                android:textColor="@color/on_gold" android:textSize="18sp" android:fontFamily="sans-serif-black" />

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
                android:gravity="center" android:textColor="@color/muted" android:textSize="12sp"
                android:text="Hesabın bu cihazda saklanır." />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
