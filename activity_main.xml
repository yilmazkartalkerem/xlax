<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:paddingHorizontal="28dp" android:paddingVertical="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/k_logo" />
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:orientation="vertical" android:layout_marginStart="12dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Kerem Kartal"
                android:textSize="19sp" android:fontFamily="sans-serif-black" />
            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical">
                <View android:id="@+id/dotStatus" android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/dot" />
                <TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp" android:text="Sunucu kapalı" android:textColor="@color/muted" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
        <LinearLayout android:id="@+id/userChip" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:background="@drawable/bg_dark_btn" android:padding="8dp">
            <ImageView android:id="@+id/ivAvatar" android:layout_width="30dp" android:layout_height="30dp" />
            <TextView android:id="@+id/tvUser" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp" android:textStyle="bold" android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:id="@+id/card" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:layout_marginHorizontal="70dp" android:layout_marginVertical="12dp"
        android:background="@drawable/bg_card" android:clipToOutline="true">

        <LinearLayout android:id="@+id/slideChannel" android:layout_width="match_parent" android:layout_height="match_parent"
            android:orientation="vertical" android:gravity="center">
            <ImageView android:layout_width="64dp" android:layout_height="64dp" android:src="@drawable/k_logo" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="Kerem Kartal" android:textSize="30sp" android:fontFamily="sans-serif-black" android:textColor="#F4EEDD" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="YouTube kanalım" android:textColor="@color/muted" android:textSize="14sp" />
            <TextView android:id="@+id/btnChannel" android:layout_width="wrap_content" android:layout_height="40dp"
                android:layout_marginTop="12dp" android:paddingHorizontal="26dp" android:gravity="center"
                android:text="Kanalı aç" android:textStyle="bold" android:textColor="@color/on_gold" android:background="@drawable/bg_gold" />
        </LinearLayout>

        <FrameLayout android:id="@+id/slideVideo" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone">
            <ImageView android:id="@+id/ivThumb" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="centerCrop" />
            <WebView android:id="@+id/web" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#00000000" />
            <View android:id="@+id/touch" android:layout_width="match_parent" android:layout_height="match_parent" />
            <TextView android:id="@+id/tvVideoTitle" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="bottom" android:background="@drawable/bg_gradient_bottom" android:padding="18dp"
                android:paddingBottom="22dp" android:maxLines="2" android:textStyle="bold" android:textSize="15sp" />
        </FrameLayout>

        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="3dp" android:layout_gravity="bottom"
            android:max="1000" android:progressTint="@color/gold" android:progressBackgroundTint="#00000000" />
        <TextView android:id="@+id/btnPrev" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_gravity="start|center_vertical" android:layout_marginStart="8dp" android:gravity="center"
            android:text="‹" android:textSize="22sp" android:background="@drawable/bg_circle_btn" />
        <TextView android:id="@+id/btnNext" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_gravity="end|center_vertical" android:layout_marginEnd="8dp" android:gravity="center"
            android:text="›" android:textSize="22sp" android:background="@drawable/bg_circle_btn" />
    </FrameLayout>

    <LinearLayout android:id="@+id/dots" android:layout_width="match_parent" android:layout_height="12dp"
        android:gravity="center" android:orientation="horizontal" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:gravity="center">
        <TextView android:id="@+id/btnSettings" android:layout_width="150dp" android:layout_height="46dp"
            android:gravity="center" android:text="Ayarlar" android:textStyle="bold" android:background="@drawable/bg_dark_btn" />
        <TextView android:id="@+id/btnPlay" android:layout_width="230dp" android:layout_height="58dp"
            android:layout_marginHorizontal="14dp" android:gravity="center" android:text="OYNA!"
            android:textSize="24sp" android:fontFamily="sans-serif-black" android:textColor="@color/on_gold"
            android:background="@drawable/bg_gold" />
        <TextView android:id="@+id/btnSkin" android:layout_width="150dp" android:layout_height="46dp"
            android:gravity="center" android:text="Skin değiştir" android:textStyle="bold" android:background="@drawable/bg_dark_btn" />
    </LinearLayout>
</LinearLayout>
